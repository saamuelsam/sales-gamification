# Server
NODE_ENV=production
PORT=4000

# Database PostgreSQL (usar service names do docker-compose em produção)
DB_HOST=sales_postgres
DB_PORT=5432
DB_NAME=sales_gamification
DB_USER=admin
DB_PASSWORD=CHANGE_THIS_PASSWORD
DB_POOL_MIN=2
DB_POOL_MAX=10

# Redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=

# JWT
JWT_SECRET=CHANGE_THIS_SECRET_KEY_IN_PRODUCTION
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=CHANGE_THIS_REFRESH_SECRET_KEY
JWT_REFRESH_EXPIRES_IN=30d

# App
BCRYPT_ROUNDS=10

# Database URL (usar service name 'sales_postgres' em produção)
DATABASE_URL=postgres://admin:CHANGE_THIS_PASSWORD@sales_postgres:5432/sales_gamification

# Frontend URL
FRONTEND_URL=https://sales.sesfortal.com.br

# SMTP Hostinger
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=seu-email@seudominio.com
SMTP_PASS=sua-senha-do-email
SMTP_FROM_EMAIL=noreply@seudominio.com
SMTP_FROM_NAME=Fortal Sales Gamification

