# Server
NODE_ENV=production
PORT=4000

# Database PostgreSQL (usar service names do docker-compose em produção)
DB_HOST=sales_postgres
DB_PORT=5432
DB_NAME=sales_gamification
DB_USER=admin
DB_PASSWORD=CHANGE_THIS_PASSWORD
DB_POOL_MIN=2
DB_POOL_MAX=10

# Redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=

# JWT
JWT_SECRET=CHANGE_THIS_SECRET_KEY_IN_PRODUCTION
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=CHANGE_THIS_REFRESH_SECRET_KEY
JWT_REFRESH_EXPIRES_IN=30d

# App
BCRYPT_ROUNDS=10

# Database URL (usar service name 'sales_postgres' em produção)
DATABASE_URL=postgres://admin:CHANGE_THIS_PASSWORD@sales_postgres:5432/sales_gamification

# Frontend URL
FRONTEND_URL=https://sales.sesfortal.com.br

# SendGrid Email (configurar com email verificado)
SENDGRID_API_KEY=YOUR_SENDGRID_API_KEY_HERE
SENDGRID_FROM_EMAIL=your-verified-email@example.com
SENDGRID_FROM_NAME=Fortal Sales Gamification

