{
  "name": "sales-gamification-backend",
  "version": "1.0.0",
  "description": "Backend para sistema de gestão de vendas e gamificação",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx -r tsconfig-paths/register src/server.ts",
    "build": "tsc -p tsconfig.json && tsc-alias",
    "start": "node -r tsconfig-paths/register dist/server.js",
    "migrate": "tsx -r tsconfig-paths/register src/database/migrate.ts",
    "seed": "tsx -r tsconfig-paths/register src/database/seed.ts",
    "test-flow": "tsx -r tsconfig-paths/register scripts/test_flow.ts",
    "monthly-maintenance": "tsx -r tsconfig-paths/register scripts/monthly_maintenance.ts",
    "test-email": "tsx -r tsconfig-paths/register scripts/test_email.ts"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "compression": "^1.8.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.18.2",
    "express-mongo-sanitize": "^2.2.0",
    "express-rate-limit": "^8.2.1",
    "express-validator": "^7.0.1",
    "helmet": "^8.1.0",
    "hpp": "^0.2.3",
    "jsonwebtoken": "^9.0.2",
    "knex": "^3.1.0",
    "nodemailer": "^6.9.7",
    "pg": "^8.11.3",
    "redis": "^4.6.13",
    "tsconfig-paths": "^4.2.0",
    "winston": "^3.11.0"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.5",
    "@types/knex": "^0.16.1",
    "@types/node": "^20.11.5",
    "@types/nodemailer": "^6.4.14",
    "@types/pg": "^8.10.9",
    "tsc-alias": "^1.8.8",
    "tsx": "^4.7.0",
    "typescript": "^5.3.3"
  }
}
